<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar widget: today's Persian date and what's next. Filled by CalendarWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_cal_bg"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:minWidth="76dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cal_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_medium"
            android:textColor="#9FB0D9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cal_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/cal_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:textColor="#7FA8FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cal_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_cal_button"
            android:fontFamily="@font/vazirmatn_bold"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#2EFFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cal_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView android:id="@+id/cal_l1" style="@style/WidgetCalLine" />
        <TextView android:id="@+id/cal_l2" style="@style/WidgetCalLine" />
        <TextView android:id="@+id/cal_l3" style="@style/WidgetCalLine" />
        <TextView android:id="@+id/cal_l4" style="@style/WidgetCalLine" />

        <TextView
            android:id="@+id/cal_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_regular"
            android:textColor="#9FB0D9"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
