<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar widget in the "bank app" look: blue date panel, next days, next item, buttons. Filled by CalendarWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wr_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Blue panel: app name, weekday pill, big date, next five days -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/wr_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/cow_cut" />

            <TextView
                android:id="@+id/cal_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/lalezar"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/cal_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="170dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_medium"
                android:textColor="#D6E2FF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cal_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_black"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/cal_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/wr_pill"
                android:fontFamily="@font/vazirmatn_medium"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/cal_d1" style="@style/WidgetDay" />
            <TextView android:id="@+id/cal_d2" style="@style/WidgetDay" />
            <TextView android:id="@+id/cal_d3" style="@style/WidgetDay" />
            <TextView android:id="@+id/cal_d4" style="@style/WidgetDay" />
            <TextView android:id="@+id/cal_d5" style="@style/WidgetDay" />
        </LinearLayout>
    </LinearLayout>

    <!-- Gold and dollar -->
    <LinearLayout
        android:id="@+id/cal_prices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/cal_p1" style="@style/WidgetPrice" />
        <TextView android:id="@+id/cal_p2" style="@style/WidgetPrice" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/cal_p3" style="@style/WidgetPrice" android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Glass card: what's next -->
    <LinearLayout
        android:id="@+id/cal_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/wr_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

                <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cal_dot"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/wr_day"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cal_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/cal_when"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:maxLines="1"
                    android:textColor="#9FB0D9"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/cal_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_black"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView android:id="@+id/cal_l2" style="@style/WidgetCalLine" />
        <TextView android:id="@+id/cal_l3" style="@style/WidgetCalLine" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cal_btn_cal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/wr_round"
            android:padding="11dp"
            android:src="@drawable/ic_w_calendar" />

        <ImageView
            android:id="@+id/cal_btn_bank"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/wr_round"
            android:padding="11dp"
            android:src="@drawable/ic_w_bank" />

        <TextView
            android:id="@+id/cal_home"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/wr_dark_btn"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cal_add"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/wr_blue_btn"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
